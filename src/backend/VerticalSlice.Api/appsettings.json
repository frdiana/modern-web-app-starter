{
  "Application": {
    "Name": "VerticalSlice"
  },
  "FeatureManagement": {
    "GreetingEndpoint": true
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "ReverseProxy": {
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}